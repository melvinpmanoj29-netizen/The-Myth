# ============================================================
# THE MYTH - SUPERHERO HELP PORTAL
# Environment Variables Configuration
# ============================================================

# Google Gemini API Key for conversational persona intelligence (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP Configuration for Real Email Delivery (Server-Side Only)
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=your_gmail_address@gmail.com
GMAIL_SMTP_PASSWORD=your_gmail_app_password_here
GMAIL_FROM_EMAIL=your_gmail_address@gmail.com
GMAIL_FROM_NAME=THE MYTH

# Website owner / personal email where incoming help requests are transmitted
MYTH_EMAIL_TO=your_personal_gmail@gmail.com
